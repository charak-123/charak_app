SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
JWT_SECRET=change_me_64_random_hex_chars
MSG91_API_KEY=
MSG91_SENDER_ID=CHARAK
MSG91_TEMPLATE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# REQUIRED in any real deployment: without it unsigned webhooks are refused.
RAZORPAY_WEBHOOK_SECRET=
# Local dev only — enables /stub-complete and unsigned webhooks. Never set this
# in production; leave empty so payment-proof checks stay enforced.
ALLOW_INSECURE_PAYMENTS=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=asia-south1
GEMINI_MODEL=gemini-2.5-flash
# Fallback only, if Vertex is not configured:
OPENAI_API_KEY=

# Ops/admin console login password. REQUIRED for admin login to work — there is
# no built-in default, and /admin/login returns 503 until this is set.
ADMIN_PASSWORD=
# Shared secret for internal cron endpoints (payment-hold sweeper, payout runs).
CRON_SECRET=
