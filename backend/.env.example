SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
JWT_SECRET=change_me_64_random_hex_chars
MSG91_API_KEY=
MSG91_SENDER_ID=CHARAK
MSG91_TEMPLATE_ID=
# Local dev only — print OTP codes to the log instead of sending SMS. Without
# this or MSG91 keys, phone sign-in is off and the apps use Google.
ALLOW_OTP_STUB=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# REQUIRED in any real deployment: without it unsigned webhooks are refused.
RAZORPAY_WEBHOOK_SECRET=
# Local dev only — enables /stub-complete and unsigned webhooks. Never set this
# in production; leave empty so payment-proof checks stay enforced.
ALLOW_INSECURE_PAYMENTS=
# Google Sign-In: the Web OAuth client id (…apps.googleusercontent.com).
GOOGLE_CLIENT_IDS=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=asia-south1
GEMINI_MODEL=gemini-2.5-flash
# Fallback only, if Vertex is not configured:
OPENAI_API_KEY=

# Admin accounts are per-person with mandatory TOTP, created with
# scripts/create_admin.py (needs SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# above). Nothing to set here. ADMIN_TOKEN_TTL_HOURS defaults to 12.
# Shared secret for internal cron endpoints (payment-hold sweeper, payout runs).
CRON_SECRET=

# Hardening (defaults shown are what production should use):
# X-Forwarded-For entries our own proxies append — 1 for Cloud Run's run.app URL,
# 2 if an external HTTPS load balancer sits in front.
TRUSTED_PROXY_HOPS=1
# Phone sign-in sends SMS only to these country codes.
OTP_ALLOWED_COUNTRY_CODES=+91
# Procedure bills above this always go to senior review.
PROCEDURE_REVIEW_THRESHOLD_MAX=5000
# Local development only — publishes /docs and /openapi.json.
ENABLE_API_DOCS=
