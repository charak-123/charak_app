<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing in this app is backed up or carried to a new phone (Android 12+).

  The session token lives in EncryptedSharedPreferences, whose key is bound to
  this device's Keystore and never leaves it. Restoring the encrypted file
  without the key does not log anyone in; it only leaves storage that can no
  longer be decrypted. The rest is cached health and booking data that the
  server re-sends after sign-in. A fresh device means a fresh sign-in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
