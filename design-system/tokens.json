{
  "meta": {
    "name": "CHARAK Design System",
    "version": "2.0.0",
    "source": "design-system/CHARAK_Design_System_V2.pdf",
    "principle": "Care that reads at a glance. Blue acts, Chandan welcomes.",
    "note": "Single source of truth. Edit this file, then run `python3 design-system/tool/generate.py`. Never hand-edit generated outputs."
  },

  "color": {
    "ramp": {
      "blue": {
        "role": "Primary · trust, every action",
        "brand": "500",
        "50": "#EEF3FD", "100": "#D9E4FA", "200": "#B3C8F4", "300": "#84A5EC", "400": "#4F7CDD",
        "500": "#2456C9", "600": "#1D45A6", "700": "#183885", "800": "#132B66", "900": "#0D1D45"
      },
      "chandan": {
        "role": "Brand warmth · from the logo (copper wordmark, gold halo)",
        "brand": "500",
        "50": "#FDF8EF", "100": "#F7EAD4", "200": "#EDD2A6", "300": "#DDB06A", "400": "#C88442",
        "500": "#A85A26", "600": "#8E4B1F", "700": "#733C19", "800": "#572D13", "900": "#3B1E0C"
      },
      "sage": {
        "role": "Health, success · the leaves",
        "brand": "500",
        "50": "#F3F4EC", "100": "#E3E6D4", "200": "#C8CDAE", "300": "#A9B087", "400": "#8A9266",
        "500": "#6F774F", "600": "#5C613F", "700": "#4A4F33", "800": "#373B27", "900": "#25281A"
      },
      "ink": {
        "role": "Text, chrome, doctor app",
        "brand": "900",
        "50": "#F4F5F7", "100": "#E6E8EC", "200": "#CDD1D8", "300": "#A6ADB8", "400": "#7A8494",
        "500": "#566072", "600": "#3C4556", "700": "#283142", "800": "#182031", "900": "#0E1726"
      }
    },

    "status": {
      "requested": { "label": "Requested",       "solid": "#C88442" },
      "accepted":  { "label": "Accepted",        "solid": "#2456C9" },
      "confirmed": { "label": "Paid · Confirmed", "solid": "#5E7F3A" },
      "active":    { "label": "Active visit",    "solid": "#6B4FC9" },
      "review":    { "label": "Needs review",    "solid": "#E07A1F" },
      "declined":  { "label": "Declined",        "solid": "#D23B3B" }
    },

    "scheme": {
      "patient": {
        "brightness": "light",
        "ground":      "#F7F3EC",
        "card":        "#FFFFFF",
        "tint":        "#EEF3FD",
        "warm":        "#FDF8EF",
        "fill":        "#F4F5F7",
        "text":        "#0E1726",
        "textMuted":   "#566072",
        "textFaint":   "#A6ADB8",
        "line":        "#E6E8EC",
        "lineStrong":  "#CDD1D8",
        "primary":     "#2456C9",
        "onPrimary":   "#FFFFFF",
        "primaryPressed": "#1D45A6",
        "primarySoft": "#EEF3FD",
        "primaryMid":  "#D9E4FA",
        "onPrimarySoft": "#183885",
        "accentWarm":  "#A85A26",
        "accentWarmSoft": "#F7EAD4",
        "onAccentWarmSoft": "#733C19",
        "greeting":    "#8E4B1F",
        "success":     "#5E7F3A",
        "warning":     "#E07A1F",
        "danger":      "#D23B3B",
        "dangerSoft":  "#FBE3E3",
        "onDangerSoft": "#A12A2A",
        "chrome":      "#0E1726",
        "onChrome":    "#FFFFFF",
        "scrim":       "#730E1726",
        "status": {
          "requested": { "soft": "#F7EAD4", "on": "#733C19" },
          "accepted":  { "soft": "#D9E4FA", "on": "#183885" },
          "confirmed": { "soft": "#E6EEDC", "on": "#3F5A24" },
          "active":    { "soft": "#ECE7FA", "on": "#4A3499" },
          "review":    { "soft": "#FDEBD9", "on": "#9A4E0C" },
          "declined":  { "soft": "#FBE3E3", "on": "#A12A2A" },
          "neutral":   { "soft": "#F4F5F7", "on": "#3C4556" }
        }
      },
      "doctor": {
        "brightness": "dark",
        "ground":      "#0E1726",
        "card":        "#182031",
        "tint":        "#132B66",
        "warm":        "#3B1E0C",
        "fill":        "#283142",
        "text":        "#F4F5F7",
        "textMuted":   "#A6ADB8",
        "textFaint":   "#7A8494",
        "line":        "#283142",
        "lineStrong":  "#3C4556",
        "primary":     "#2456C9",
        "onPrimary":   "#FFFFFF",
        "primaryPressed": "#1D45A6",
        "primarySoft": "#132B66",
        "primaryMid":  "#183885",
        "onPrimarySoft": "#B3C8F4",
        "accentWarm":  "#DDB06A",
        "accentWarmSoft": "#3B1E0C",
        "onAccentWarmSoft": "#EDD2A6",
        "greeting":    "#DDB06A",
        "success":     "#A9B087",
        "warning":     "#F0A35E",
        "danger":      "#F07C7C",
        "dangerSoft":  "#3A1F24",
        "onDangerSoft": "#F4A5A5",
        "chrome":      "#0E1726",
        "onChrome":    "#FFFFFF",
        "scrim":       "#99000000",
        "status": {
          "requested": { "soft": "#3B1E0C", "on": "#EDD2A6" },
          "accepted":  { "soft": "#132B66", "on": "#B3C8F4" },
          "confirmed": { "soft": "#25281A", "on": "#C8CDAE" },
          "active":    { "soft": "#2A2152", "on": "#CFC3F5" },
          "review":    { "soft": "#3D2410", "on": "#F6C08F" },
          "declined":  { "soft": "#3A1F24", "on": "#F4A5A5" },
          "neutral":   { "soft": "#283142", "on": "#CDD1D8" }
        }
      }
    },

    "tile": {
      "general":     { "bg": "#EEF3FD", "fg": "#183885" },
      "paediatrics": { "bg": "#FDF8EF", "fg": "#733C19" },
      "cardiology":  { "bg": "#FBEAEA", "fg": "#A12A2A" },
      "ayurveda":    { "bg": "#E3E6D4", "fg": "#4A4F33" },
      "skin":        { "bg": "#ECE7FA", "fg": "#4A3499" },
      "ortho":       { "bg": "#F4F5F7", "fg": "#283142" }
    },

    "mix": {
      "note": "Share of a typical patient screen. Keep blue to ~10% so it keeps meaning 'tap here'.",
      "ground": 58, "card": 24, "blue": 10, "chandanSage": 5, "status": 3
    }
  },

  "type": {
    "family": "Anek",
    "familyDevanagari": "AnekDevanagari",
    "files": {
      "Anek": "packages/charak_core/fonts/AnekLatin-Variable.ttf",
      "AnekDevanagari": "packages/charak_core/fonts/AnekDevanagari-Variable.ttf"
    },
    "axes": { "wdth": [75, 125], "wght": [100, 800] },
    "rules": [
      "Headers never go below width 118.",
      "Numbers (fees, times, ratings, countdowns) always use tabular figures and the narrow width.",
      "One family in two scripts: English, Hindi and Marathi sound the same."
    ],
    "style": {
      "display":     { "size": 56, "line": 60, "weight": 750, "width": 125 },
      "titleLarge":  { "size": 36, "line": 42, "weight": 700, "width": 122 },
      "titleMedium": { "size": 26, "line": 32, "weight": 650, "width": 118 },
      "titleSmall":  { "size": 20, "line": 26, "weight": 650, "width": 112 },
      "bodyLarge":   { "size": 18, "line": 26, "weight": 400, "width": 100 },
      "body":        { "size": 16, "line": 24, "weight": 400, "width": 100 },
      "label":       { "size": 15, "line": 20, "weight": 600, "width": 105 },
      "caption":     { "size": 13, "line": 18, "weight": 500, "width": 100 },
      "overline":    { "size": 12, "line": 16, "weight": 700, "width": 110, "tracking": 1.2, "uppercase": true },
      "numeric":     { "size": 20, "line": 24, "weight": 600, "width": 80, "tabular": true }
    }
  },

  "radius": {
    "pill": 999,
    "sheet": 32,
    "card": 26,
    "tile": 20,
    "field": 20,
    "avatar": 16
  },

  "size": {
    "buttonMinHeight": 52,
    "buttonCompact": 44,
    "chipHeight": 40,
    "touchMin": 44,
    "bottomBarHeight": 68,
    "navPillWidth": 56,
    "navPillHeight": 32,
    "nowBarHeight": 60
  },

  "space": {
    "xs": 4, "sm": 8, "md": 12, "base": 16, "gutter": 20, "lg": 24, "xl": 32, "xxl": 48
  },

  "elevation": {
    "note": "Flat, tonal, rounded. There are NO drop shadows. Depth comes from white cards on the cream ground (patient) or ink-800 cards on ink-900 (doctor)."
  },

  "motion": {
    "pressScale": 0.96,
    "liftOffset": 20,
    "maxDuration": 450,
    "token": {
      "press":      { "ms": 150,  "curve": [0.22, 1, 0.36, 1], "use": "Buttons, tiles, rows · scale 0.96" },
      "standard":   { "ms": 300,  "curve": [0.33, 0, 0.1, 1],  "use": "Tabs, segments, status, colour" },
      "emphasized": { "ms": 450,  "curve": [0.22, 1, 0.36, 1], "use": "Enter, Now Bar, sheets, card → screen" },
      "exit":       { "ms": 200,  "curve": [0.4, 0, 1, 1],     "use": "Dismiss, heads-up out, close" },
      "stagger":    { "ms": 40,   "maxItems": 6, "use": "Added per item on screen enter (240ms tail max)" },
      "live":       { "ms": 1600, "use": "Pulse on anything happening now (looping)" },
      "reduced":    { "ms": 150,  "use": "Everything becomes a plain fade when Reduce motion is on" }
    },
    "header": { "fadeStart": 170, "fadeEnd": 230, "parallax": 0.35, "use": "Large title → app bar, linear, tied to scroll" }
  }
}
